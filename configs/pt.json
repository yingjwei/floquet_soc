    "eig": "Pt.eig",
    "spn": "Pt.spn",
    "wout": "Pt.wout",
    "bands_ref": "Pt_band.dat",
    "bands_ref_kpt": "Pt_band.kpt"
  },
  "spin": {
    "source": "spn",
    "file": "Pt.spn",
    "chk": "Pt.chk",
    "eig": "Pt.eig"
  },
  "num_electrons": 10,
  "kpath": [
    [
      "W",
      [
        0.25,
        0.75,
        0.5
      ]
    ],
    [
      "L",
      [
        0.5,
        0.5,
        0.5
      ]
    ],
    [
      "G",
      [
        0.0,
        0.0,
        0.0
      ]
    ],
    [
      "X",
      [
        0.5,
        0.0,
        0.5
      ]
    ],
    [
      "W",
      [
        0.5,
        0.25,
        0.75
      ]
    ],
    [
      "G",
      [
        0.0,
        0.0,
        0.0
      ]
    ]
  ],
  "nk_seg": 15,
  "kmesh": {
    "dk": 0.01,
    "kind": "auto-2pi-per-A"
  },
  "kmesh_pst": {
    "dk": 0.01,
    "kind": "auto-2pi-per-A"
  },
  "scan": {
    "hw": [
      0.5,
      1.0,
      1.5
    ],
    "gamma": [
      0.0,
      0.02,
      0.04
    ],
